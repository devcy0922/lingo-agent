# LingoAgent Environment Configuration

# Service Host & Port
PORT=47081
HOST=0.0.0.0

# LLM Gateway Config
# 실행 환경의 보안 게이트웨이 주소를 입력합니다.
LLM_GATEWAY_URL=https://api.govail.cloud/v1
# 이 레포 전용으로 발급된 게이트웨이 키를 입력합니다.
LLM_API_KEY=
LLM_MODEL=govail/thinker

# Database Settings (데모 편의성을 위해 기본 SQLite 사용)
DATABASE_URL=sqlite:///./data/db.sqlite3

# Output Path (최종 승인된 i18n JSON 파일이 저장될 경로)
OUTPUT_DIR=./data/output
